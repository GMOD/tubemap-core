{
  "name": "@jbrowse/tubemap-core",
  "version": "2.1.1",
  "description": "The sequenceTubeMap layout: pangenome graph paths and reads as tube map shapes, with no DOM or d3",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "Colin Diesh",
    "email": "colin.diesh@gmail.com",
    "url": "https://github.com/cmdcolin"
  },
  "main": "dist/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./dist/index.js"
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "scripts": {
    "test": "vitest",
    "coverage": "pnpm test --coverage",
    "clean": "rimraf dist esm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "prebuild": "pnpm clean",
    "build": "pnpm build:esm && pnpm build:es5",
    "build:esm": "tsc --outDir esm",
    "build:es5": "tsc --module commonjs --moduleResolution bundler --outDir dist",
    "postbuild:es5": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "test:pack": "./scripts/test-pack.sh",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --run && pnpm build && pnpm test:pack",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "git-cliff": "^2.14.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMOD/tubemap-core.git"
  },
  "keywords": [
    "pangenome",
    "tubemap",
    "sequencetubemap",
    "variation-graph",
    "visualization",
    "genomics"
  ],
  "publishConfig": {
    "access": "public"
  }
}
